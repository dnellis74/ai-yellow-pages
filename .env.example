# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Used by adjudicate.js only. The key is read from the environment, never from this repo.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
